def jogar(): 
    print("\n escolha a dificuldade:")
    print("1 - Fácil")
    print("2 - Médio")
    print("3 - Difícil")
    
    opcao = input("Digite o número da dificuladade: ").strip()
    
    if opcao == "1":
        nivel = "fácil"
    elif opcao == "2":
        nivel = "médio"
    elif opcao == "3":
        nivel = "difícil"
    else:
        print(" inválido! dificuldade: 'Fácil'.")
        nivel = "fácil"

    vocabulario = palavras_por_nivel[nivel]
    chances = 3
    pontos = 0
    
    # Lista de palavras do nível escolhido
    perguntas = list(vocabulario.items())
    random.shuffle(perguntas)

    print(f"\n dificuladade selecionada: {nivel.upper()} | chances restantes: {chances}")
    print("Vamos começar!\n")

    for pt, en in perguntas:
        if chances <= 0:
            break
            
        print(f"Traduza para o inglês: 🇧🇷 **{pt.upper()}**")
        
        # O usuário fala a resposta
        resposta_usuario = ouvir_microfone()
        print(f"Você disse: '{resposta_usuario}'")
        
        if resposta_usuario == en:
            print("Certa Resposta! +10 pontos.")
            pontos += 10
        else:
            print(f"Errou!! era: '{en}'")
            chances -= 1
            print(f"chances restantes: {chances}")
            
    print(f"Pontuação: {pontos} pontos")
    print("parábens")
if __name__ == "__main__":
